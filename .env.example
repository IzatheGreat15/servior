# Local Supabase defaults. Replace the key with the anon/publishable key for your project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=http://127.0.0.1:3000

# Required by Playwright e2e setup to create an isolated test branch on the local database.
SUPABASE_DB_URL=postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:54322/postgres
